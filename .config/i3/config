# Variables
set $MOD Mod4
set $ALT Mod1
set $BROWSER firefox
set $FM thunar
set $TERM alacritty 
set $SCREENSHOT flameshot gui 
set $DISCORD vesktop
set $TELEGRAM materialgram
set $STARTER rofi -show drun -theme ~/.config/rofi/rofi-tui.rasi
set $EDITOR zed
set $PSKEY Print

# Gaps
gaps inner 10
gaps outer 5
gaps top 34

# Window rules
for_window [class="^.*"] border pixel 2
for_window [class="fl64.exe" title="^$"] move scratchpad
for_window [class="SoneWidget"] floating enable, border none, sticky enable
for_window [title="Sone Track Widget"] floating enable, border none, sticky enable
floating_modifier $MOD

# Colors
client.focused          #FFB800 #0C0C0C #FFFFFF #FFB800 #FFB800
client.unfocused        #252525 #0C0C0C #888888 #252525 #252525
client.focused_inactive #333333 #0C0C0C #888888 #333333 #333333
client.urgent           #E06C75 #0C0C0C #FFFFFF #E06C75 #E06C75

# Autostart
exec --no-startup-id ~/.config/i3/scripts/autostart.sh
exec --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle

# System Binds 
bindsym $MOD+Shift+r restart
bindsym --release $MOD+q kill
bindsym $ALT+a floating toggle 
bindsym $ALT+f fullscreen toggle

# Binds 
bindsym $MOD+Return exec $TERM
bindsym $MOD+r exec $STARTER
bindsym $MOD+d exec $DISCORD
bindsym $MOD+b exec $BROWSER
bindsym $MOD+e exec $FM
bindsym $MOD+m exec --no-startup-id pkill -USR1 -f sone_widget/widget.py
bindsym $MOD+p exec --no-startup-id pkill -USR1 -f perf_widget/widget.py
bindsym Print exec $SCREENSHOT

# Workspaces
bindsym $MOD+1 workspace 1
bindsym $MOD+2 workspace 2
bindsym $MOD+3 workspace 3
bindsym $MOD+4 workspace 4
bindsym $MOD+5 workspace 5
bindsym $MOD+6 workspace 6
bindsym $MOD+7 workspace 7
bindsym $MOD+8 workspace 8
bindsym $MOD+9 workspace 9

bindsym $MOD+Shift+1 move container to workspace 1; workspace 1
bindsym $MOD+Shift+2 move container to workspace 2; workspace 2
bindsym $MOD+Shift+3 move container to workspace 3; workspace 3
bindsym $MOD+Shift+4 move container to workspace 4; workspace 4
bindsym $MOD+Shift+5 move container to workspace 5; workspace 5
bindsym $MOD+Shift+6 move container to workspace 6; workspace 6
bindsym $MOD+Shift+7 move container to workspace 7; workspace 7
bindsym $MOD+Shift+8 move container to workspace 8; workspace 8
bindsym $MOD+Shift+9 move container to workspace 9; workspace 9
