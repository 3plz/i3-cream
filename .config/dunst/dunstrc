# ============================================================
#  Wu-Tang Clan TUI Dunst Configuration
#  Theme: Pitch Black & Wu-Tang Gold (#FFB800)
# ============================================================

[global]
    ### Display & Monitor ###
    monitor = 0
    follow = none

    ### Geometry ###
    width = (300, 420)
    height = (60, 250)
    origin = top-right
    offset = (20, 48)
    scale = 0
    notification_limit = 5

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0
    progress_bar_corners = all

    ### Appearance & Borders ###
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#FFB800"
    gap_size = 8
    separator_color = frame
    sort = yes
    corner_radius = 0

    ### Text & Typography ###
    font = Terminess Nerd Font 10
    line_height = 2
    markup = full
    format = "<b><span color='#FFB800'>%s</span></b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Papirus, Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 0

    ### History & Interactions ###
    sticky_history = yes
    history_length = 20

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0C0C0C"
    foreground = "#A0A0A0"
    frame_color = "#333333"
    highlight = "#786C4A"
    timeout = 4

[urgency_normal]
    background = "#0C0C0C"
    foreground = "#F0F0F0"
    frame_color = "#FFB800"
    highlight = "#FFB800"
    timeout = 6

[urgency_critical]
    background = "#140505"
    foreground = "#FFFFFF"
    frame_color = "#E53935"
    highlight = "#E53935"
    timeout = 0
